          "required": [
            "previousInsurerId",
            "yearsContinuouslyInsured",
            "previousPolicyCancelledByInsurer",
            "hasClaims"
          ],
          "title": "History",
          "allOf": [
            {
              "if": {
                "properties": {
                  "hasClaims": {
                    "const": true
                  }
                },
                "required": [
                  "hasClaims"
                ]
              },
              "then": {
                "required": [
                  "claims"
                ],
                "properties": {
                  "claims": {}
                }
              }
            }
          ]
        },
