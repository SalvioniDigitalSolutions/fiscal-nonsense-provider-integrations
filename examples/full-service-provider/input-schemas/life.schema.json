        },
        "termYears": {
          "type": "integer",
          "minimum": 0,
          "title": "Term years"
        },
        "benefitPattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "title": "Benefit pattern"
        },
        "jointLife": {
          "type": "boolean",
          "title": "Joint life"
