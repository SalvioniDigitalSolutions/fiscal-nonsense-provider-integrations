        },
        "hazardousOccupation": {
          "type": "boolean",
          "title": "Hazardous occupation"
        },
        "extendedForeignTravel": {
          "type": "boolean",
          "title": "Extended foreign travel"
        }
      },
      "required": [
        "hazardousSports",
        "hazardousOccupation",
        "extendedForeignTravel"
      ],
      "title": "Activities"
    },
    "financial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annualIncome": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d{0,11})\\.\\d{2}$",
          "title": "Annual income"
        },
        "existingLifeCover": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d{0,11})\\.\\d{2}$",
