  },
  "required": [
    "common",
    "insuredPerson",
    "medical",
    "cover",
    "benefit",
    "activities",
    "financial"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fictional life required provider inputs",
  "description": "Synthetic provider specification, not a universal underwriting questionnaire. Real providers must verify all fields and conditions."
}
