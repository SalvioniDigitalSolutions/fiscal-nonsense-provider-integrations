{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "common": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policyholder": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dateOfBirth": {
              "type": "string",
              "format": "date",
              "title": "Date of birth"
            },
            "nationality": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "title": "Nationality"
            },
            "residenceCountry": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "title": "Residence country"
            },
            "residencePostalCode": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "title": "Residence postal code"
            },
            "residenceMunicipality": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "title": "Residence municipality"
            },
            "occupationCode": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "title": "Occupation code"
            },
            "householdAdults": {
              "type": "integer",
              "minimum": 0,
              "title": "Household adults"
            },
            "householdChildren": {
              "type": "integer",
              "minimum": 0,
              "title": "Household children"
            }
          },
          "required": [
            "dateOfBirth",
            "nationality",
            "residenceCountry",
            "residencePostalCode",
            "residenceMunicipality",
            "occupationCode",
            "householdAdults",
            "householdChildren"
          ],
          "title": "Policyholder"
        },
        "history": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "previousInsurerId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "title": "Previous insurer id"
            },
            "yearsContinuouslyInsured": {
              "type": "integer",
              "minimum": 0,
              "title": "Years continuously insured"
            },
            "previousPolicyCancelledByInsurer": {
              "type": "boolean",
              "title": "Previous policy cancelled by insurer"
            },
            "hasClaims": {
              "type": "boolean",
              "title": "Has claims"
            },
            "claims": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "date": {
                    "type": "string",
                    "format": "date",
                    "title": "Date"
                  },
                  "type": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000,
                    "title": "Type"
                  },
                  "paidAmount": {
                    "type": "string",
                    "pattern": "^(0|[1-9]\\d{0,11})\\.\\d{2}$",
                    "title": "Paid amount"
                  },
                  "open": {
                    "type": "boolean",
                    "title": "Open"
                  }
                },
                "required": [
                  "date",
                  "type",
                  "paidAmount",
                  "open"
                ]
              }
            }
          },
          "required": [
            "previousInsurerId",
            "yearsContinuouslyInsured",
            "previousPolicyCancelledByInsurer",
            "hasClaims"
          ],
          "title": "History",
          "allOf": [
            {
              "if": {
                "properties": {
                  "hasClaims": {
                    "const": true
                  }
                },
                "required": [
                  "hasClaims"
                ]
              },
              "then": {
                "required": [
                  "claims"
                ],
                "properties": {
                  "claims": {}
                }
              }
            }
          ]
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "territories": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "title": "Territories"
            },
            "paymentMethod": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "title": "Payment method"
            },
            "marketingConsent": {
              "type": "boolean",
              "title": "Marketing consent"
            }
          },
          "required": [
            "territories",
            "paymentMethod",
            "marketingConsent"
          ],
          "title": "Policy"
        }
      },
      "required": [
        "policyholder",
        "history",
        "policy"
      ],
      "title": "Common"
    },
    "vessel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "title": "Type"
        },
        "constructionYear": {
          "type": "integer",
          "minimum": 0,
          "title": "Construction year"
        },
        "lengthMetres": {
          "type": "integer",
          "minimum": 0,
          "title": "Length metres"
        },
        "value": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d{0,11})\\.\\d{2}$",
          "title": "Value"
        },
        "hullMaterial": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "title": "Hull material"
        },
        "flagCountry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "title": "Flag country"
        },
        "navigationArea": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "title": "Navigation area"
        },
        "mooringType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "title": "Mooring type"
        },
        "commercialUse": {
          "type": "boolean",
          "title": "Commercial use"
        }
      },
      "required": [
        "type",
        "constructionYear",
        "lengthMetres",
        "value",
        "hullMaterial",
        "flagCountry",
        "navigationArea",
        "mooringType",
        "commercialUse"
      ],
      "title": "Vessel"
    },
    "skipper": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "yearsExperience": {
          "type": "integer",
          "minimum": 0,
          "title": "Years experience"
        },
        "qualification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "title": "Qualification"
        },
        "claimsLastFiveYears": {
          "type": "integer",
          "minimum": 0,
          "title": "Claims last five years"
        }
      },
      "required": [
        "yearsExperience",
        "qualification",
        "claimsLastFiveYears"
      ],
      "title": "Skipper"
    },
    "cover": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hull": {
          "type": "boolean",
          "title": "Hull"
        },
        "liabilityLimit": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d{0,11})\\.\\d{2}$",
          "title": "Liability limit"
        }
      },
      "required": [
        "hull",
        "liabilityLimit"
      ],
      "title": "Cover"
    }
  },
  "required": [
    "common",
    "vessel",
    "skipper",
    "cover"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fictional marine required provider inputs",
  "description": "Synthetic provider specification, not a universal underwriting questionnaire. Real providers must verify all fields and conditions."
}
