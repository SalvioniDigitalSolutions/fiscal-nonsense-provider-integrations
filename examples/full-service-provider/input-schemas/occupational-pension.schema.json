{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "member": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dateOfBirth": {
          "type": "string",
          "format": "date",
          "title": "Date of birth"
        },
        "residenceCountry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "title": "Residence country"
        },
        "taxResidenceCountry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "title": "Tax residence country"
        },
        "taxRegion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "title": "Tax region"
        },
        "employmentStatus": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "title": "Employment status"
        },
        "maritalStatus": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "title": "Marital status"
        },
        "dependants": {
          "type": "integer",
          "minimum": 0,
          "title": "Dependants"
        }
      },
      "required": [
        "dateOfBirth",
        "residenceCountry",
        "taxResidenceCountry",
        "taxRegion",
        "employmentStatus",
        "maritalStatus",
        "dependants"
      ],
      "title": "Member"
    },
    "finances": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annualEarnedIncome": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d{0,11})\\.\\d{2}$",
          "title": "Annual earned income"
        },
        "existingPensionCapital": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d{0,11})\\.\\d{2}$",
          "title": "Existing pension capital"
        },
        "contributionsThisYear": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d{0,11})\\.\\d{2}$",
          "title": "Contributions this year"
        },
        "otherPensionAnnualIncome": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d{0,11})\\.\\d{2}$",
          "title": "Other pension annual income"
        }
      },
      "required": [
        "annualEarnedIncome",
        "existingPensionCapital",
        "contributionsThisYear",
        "otherPensionAnnualIncome"
      ],
      "title": "Finances"
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targetRetirementAge": {
          "type": "integer",
          "minimum": 0,
          "title": "Target retirement age"
        },
        "contributionIndexationPercent": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d{0,11})\\.\\d{2}$",
          "title": "Contribution indexation percent"
        },
        "beneficiaryType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "title": "Beneficiary type"
        },
        "sustainableInvestmentsRequested": {
          "type": "boolean",
          "title": "Sustainable investments requested"
        }
      },
      "required": [
        "targetRetirementAge",
        "contributionIndexationPercent",
        "beneficiaryType",
        "sustainableInvestmentsRequested"
      ],
      "title": "Preferences"
    },
    "transfer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requested": {
          "type": "boolean",
          "title": "Requested"
        }
      },
      "required": [
        "requested"
      ],
      "title": "Transfer"
    },
    "scheme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "employerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "title": "Employer id"
        },
        "joinDate": {
          "type": "string",
          "format": "date",
          "title": "Join date"
        },
        "pensionableSalary": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d{0,11})\\.\\d{2}$",
          "title": "Pensionable salary"
        },
        "employeeContributionPercent": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d{0,11})\\.\\d{2}$",
          "title": "Employee contribution percent"
        },
        "employerContributionPercent": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d{0,11})\\.\\d{2}$",
          "title": "Employer contribution percent"
        },
        "schemeRulesId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "title": "Scheme rules id"
        }
      },
      "required": [
        "employerId",
        "joinDate",
        "pensionableSalary",
        "employeeContributionPercent",
        "employerContributionPercent",
        "schemeRulesId"
      ],
      "title": "Scheme"
    }
  },
  "required": [
    "member",
    "finances",
    "preferences",
    "transfer",
    "scheme"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fictional occupational-pension required provider inputs",
  "description": "Synthetic provider specification, not a universal underwriting questionnaire. Real providers must verify all fields and conditions."
}
