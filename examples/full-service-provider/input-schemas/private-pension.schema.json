{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "member": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dateOfBirth": {
          "type": "string",
          "format": "date",
          "title": "Date of birth"
        },
        "residenceCountry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "title": "Residence country"
        },
        "taxResidenceCountry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "title": "Tax residence country"
        },
        "taxRegion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "title": "Tax region"
        },
        "employmentStatus": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "title": "Employment status"
        },
        "maritalStatus": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "title": "Marital status"
        },
        "dependants": {
          "type": "integer",
          "minimum": 0,
          "title": "Dependants"
        }
      },
      "required": [
        "dateOfBirth",
        "residenceCountry",
        "taxResidenceCountry",
        "taxRegion",
        "employmentStatus",
        "maritalStatus",
        "dependants"
      ],
      "title": "Member"
    },
    "finances": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annualEarnedIncome": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d{0,11})\\.\\d{2}$",
          "title": "Annual earned income"
        },
        "existingPensionCapital": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d{0,11})\\.\\d{2}$",
          "title": "Existing pension capital"
        },
        "contributionsThisYear": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d{0,11})\\.\\d{2}$",
          "title": "Contributions this year"
        },
        "otherPensionAnnualIncome": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d{0,11})\\.\\d{2}$",
          "title": "Other pension annual income"
        }
      },
      "required": [
        "annualEarnedIncome",
        "existingPensionCapital",
        "contributionsThisYear",
        "otherPensionAnnualIncome"
      ],
      "title": "Finances"
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targetRetirementAge": {
          "type": "integer",
          "minimum": 0,
          "title": "Target retirement age"
        },
        "contributionIndexationPercent": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d{0,11})\\.\\d{2}$",
          "title": "Contribution indexation percent"
        },
        "beneficiaryType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "title": "Beneficiary type"
        },
        "sustainableInvestmentsRequested": {
          "type": "boolean",
          "title": "Sustainable investments requested"
        }
      },
      "required": [
        "targetRetirementAge",
        "contributionIndexationPercent",
        "beneficiaryType",
        "sustainableInvestmentsRequested"
      ],
      "title": "Preferences"
    },
    "transfer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requested": {
          "type": "boolean",
          "title": "Requested"
        }
      },
      "required": [
        "requested"
      ],
      "title": "Transfer"
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wrapperType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "title": "Wrapper type"
        },
        "investmentAllocation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "assetClass": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "title": "Asset class"
              },
              "percent": {
                "type": "string",
                "pattern": "^(0|[1-9]\\d{0,11})\\.\\d{2}$",
                "title": "Percent"
              }
            },
            "required": [
              "assetClass",
              "percent"
            ]
          },
          "title": "Investment allocation"
        },
        "insuranceBenefitsRequested": {
          "type": "boolean",
          "title": "Insurance benefits requested"
        }
      },
      "required": [
        "wrapperType",
        "investmentAllocation",
        "insuranceBenefitsRequested"
      ],
      "title": "Plan"
    }
  },
  "required": [
    "member",
    "finances",
    "preferences",
    "transfer",
    "plan"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fictional private-pension required provider inputs",
  "description": "Synthetic provider specification, not a universal underwriting questionnaire. Real providers must verify all fields and conditions."
}
